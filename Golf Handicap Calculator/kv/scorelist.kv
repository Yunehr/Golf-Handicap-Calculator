#:kivy 2.3.1

<ScoreCardScreen@Screen>:
    name: "scorecard_screen"

    BoxLayout:
        orientation: "vertical"

        HeaderBar:
            id: header
            title_text: "Rounds Played"
            show_add: True
            add_callback: app.show_add_score_popup

        ScrollView:
            do_scroll_x: False

            MDLabel:
                id: score_list
                text: ""
                markup: True
                size_hint_y: None
                height: self.texture_size[1]

        NavigationBar:


<AddScorePopup@MDCard>:
    orientation: "vertical"
    size_hint: 0.9, None
    #height: "480dp"
    padding: "20dp"
    spacing: "10dp"

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "40dp"
        spacing: "20dp"

        MDLabel:
            text: "Add Score"
            font_style: "H5"
            size_hint_x: 1

        MDIconButton:
            icon: "close"
            size_hint_x: None
            width: "40dp"
            on_release: app.close_score_popup()

    MDLabel:
        text: "Select Course"
        size_hint_y: None
        height: "30dp"

    MDRaisedButton:
        id: course_selector
        text: "--No Course Selected--"
        size_hint_y: None
        height: "40dp"
        on_release: app.course_menu.open()

    MDLabel:
        text: "Score:"
        size_hint_y: None
        height: "30dp"

    MDTextField:
        id: score_input
        hint_text: "Enter score"
        input_filter: "int"
        mode: "rectangle"
        size_hint_y: None
        height: "45dp"

    BoxLayout:
        size_hint_y: None
        height: "45dp"
        spacing: "10dp"

        Widget:
            size_hint_x: 1

        MDRaisedButton:
            text: "Save Score"
            size_hint_x: None
            width: "120dp"
            on_release: app.save_score_from_popup()

        Widget:
            size_hint_x: 1