#:kivy 2.3.1
<HomeScreen@Screen>:
    name: "home_screen"

    BackgroundLayer:

    MDLabel:
        text: "Home Screen"
        font_style: "H4"
        halign: "center"
        pos_hint: {"center_y": 0.8}

    #Logout Button
    MDRaisedButton:
        text: "Logout"
        pos_hint: {"center_x": 0.5, "center_y": 0.4}
        on_release: app.login_screen()